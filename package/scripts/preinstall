#!/bin/sh
set -eu

PKG_ID=org.opencapt.lbp2900.macos
QUEUE=Canon_LBP2900_OpenCAPT
if [ "$(/usr/bin/uname -m)" != arm64 ]; then
    echo "This package requires a Mac with Apple Silicon." >&2
    exit 1
fi
case "$(/usr/bin/sw_vers -productVersion | /usr/bin/cut -d . -f 1)" in
    26|27) ;;
    *) echo "This experimental package targets macOS 26 and 27." >&2; exit 1 ;;
esac

if /usr/bin/lpstat -p "$QUEUE" >/dev/null 2>&1; then
    if ! /usr/bin/grep -q '^\*% OpenCAPT-Package: org.opencapt.lbp2900.macos$' \
        "/etc/cups/ppd/$QUEUE.ppd"; then
        echo "A different printer already uses the queue name $QUEUE." >&2
        exit 1
    fi
fi

if ! /usr/sbin/pkgutil --pkg-info "$PKG_ID" >/dev/null 2>&1; then
    for file in \
        /usr/libexec/cups/filter/canon2900-rastertocapt \
        /usr/libexec/cups/backend/canon2900usb \
        /Library/Printers/PPDs/Contents/Resources/Canon-LBP2900-OpenCAPT.ppd; do
        if [ -e "$file" ] || [ -L "$file" ]; then
            echo "An unmanaged file already exists at $file; installation stopped." >&2
            exit 1
        fi
    done
fi
exit 0

+void capt_poll_wait(unsigned *attempts, const char *phase)
+{
+	if ((*attempts)++ >= CAPT_MAX_POLLS) {
+		fprintf(stderr, "ERROR: CAPT: timed out waiting for %s; check printer and resume the queue\n", phase);
+		exit(1);
+	}
+	usleep(100000);
